# DMS One Flex MCP – konfiguráció
# Másold .env néven (npm run dev esetén), vagy add meg ezeket env változóként
# a Claude Desktop claude_desktop_config.json "env" blokkjában.

# A Flex API alap URL-je (alapértelmezett a publikus felhő)
FLEX_BASE_URL=https://flex.dmsone.hu/api

# Hitelesítési mód: "pat" (Personal Access Token) vagy "station" (gépi token)
FLEX_AUTH_METHOD=pat

# A token értéke (PAT a Flex felületen a neved menüjében hozható létre).
# KÖTELEZŐ.
FLEX_TOKEN=

# Csak station tokennél: kinek a nevében járjon el a hívás (impersonation)
FLEX_IMPERSONATED_EMAIL=

# SSL tanúsítvány hibák figyelmen kívül hagyása (csak fejlesztéshez!): true/false
FLEX_IGNORE_SSL=false

# Hova mentse a letöltött csatolmányokat (alapértelmezett: az OS temp könyvtárának
# "dmsone-flex" almappája). A letöltés CSAK ebbe a könyvtárba vagy alkönyvtárába
# írhat; relatív értéket a szerver munkakönyvtárához képest old fel — adj meg abszolút utat.
FLEX_DOWNLOAD_DIR=

# Időzóna IANA zónanévvel. A Flex helyi faliórát tárol (a dátummezőkben nincs
# offset), ezért a szervernek tudnia kell, melyik zóna a "helyi": az offsettel
# megadott dátumokat ennek a zónának a faliórájára számolja át. Elírt zónanév
# esetén a szerver figyelmeztet és az alapértelmezettre esik vissza.
FLEX_TIMEZONE=Europe/Budapest

# A csatolmány-letöltés felső határa megabájtban (alapértelmezett: 50). A válasz
# teljes egészében memóriába kerül, ezért ez a korlát védi a szerverfolyamatot a
# nagy mellékletektől. Ennél nagyobb fájlnál a letöltés hibát ad, nem csonkol.
FLEX_MAX_DOWNLOAD_MB=50

# Induláskor egyetlen GET /diag hívás a token ellenőrzésére (alapértelmezett:
# false). Lejárt/érvénytelen tokenre stderr-figyelmeztetést ad, de a szerver
# ekkor sem lép ki — a tényleges tool-hívások a saját hibaágukon úgyis jeleznek.
FLEX_CHECK_ON_START=false
